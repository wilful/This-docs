{
  "id": "car-contract",
  "name": "Договор купли-продажи автомобиля",
  "groups": [
    {
      "id": "sellers",
      "title": "Продавец",
      "repeatable": true,
      "fields": [
        {
          "key": "fio",
          "label": "ФИО",
          "type": "text",
          "required": true,
          "placeholder": "Иванов Иван Иванович",
          "autocomplete": "name"
        },
        { "key": "phone", "label": "Телефон", "type": "tel", "placeholder": "+7 (___) ___-__-__" },
        {
          "key": "address",
          "label": "Адрес регистрации",
          "type": "text",
          "placeholder": "г. …, ул. …, д. …"
        },
        {
          "key": "passport",
          "label": "Паспорт",
          "type": "text",
          "placeholder": "серия, номер, кем и когда выдан"
        }
      ]
    },
    {
      "id": "buyers",
      "title": "Покупатель",
      "repeatable": true,
      "fields": [
        {
          "key": "fio",
          "label": "ФИО",
          "type": "text",
          "required": true,
          "placeholder": "Петров Пётр Петрович",
          "autocomplete": "name"
        },
        { "key": "phone", "label": "Телефон", "type": "tel", "placeholder": "+7 (___) ___-__-__" },
        {
          "key": "address",
          "label": "Адрес регистрации",
          "type": "text",
          "placeholder": "г. …, ул. …, д. …"
        },
        {
          "key": "passport",
          "label": "Паспорт",
          "type": "text",
          "placeholder": "серия, номер, кем и когда выдан"
        }
      ]
    },
    {
      "id": "vehicle",
      "title": "Автомобиль",
      "fields": [
        {
          "key": "model",
          "label": "Марка и модель",
          "type": "text",
          "required": true,
          "placeholder": "Lada Vesta"
        },
        { "key": "vin", "label": "VIN", "type": "text", "placeholder": "17 символов" },
        { "key": "year", "label": "Год выпуска", "type": "number", "placeholder": "2020" },
        { "key": "engine", "label": "Номер двигателя", "type": "text", "placeholder": "…" },
        { "key": "body", "label": "Номер кузова / кабины", "type": "text", "placeholder": "…" },
        { "key": "chassis", "label": "Номер шасси / рамы", "type": "text", "placeholder": "если указан в документах" },
        { "key": "color", "label": "Цвет", "type": "text", "placeholder": "белый" },
        { "key": "plate", "label": "Гос. рег. знак", "type": "text", "placeholder": "А000АА 77" },
        { "key": "mileage", "label": "Пробег по одометру, км", "type": "number", "placeholder": "0" },
        { "key": "pts", "label": "ПТС (серия, номер / электронный ПТС)", "type": "text", "placeholder": "реквизиты ПТС или номер ЭПТС" },
        { "key": "sts", "label": "Свидетельство о регистрации ТС", "type": "text", "placeholder": "серия и номер" },
        { "key": "ownership", "label": "Документ о праве собственности продавца", "type": "text", "placeholder": "договор, свидетельство о наследстве и т. п." },
        { "key": "restrictions", "label": "Залог, арест, ограничения, права третьих лиц", "type": "textarea", "placeholder": "Отсутствуют или перечислите сведения" }
      ]
    },
    {
      "id": "terms",
      "title": "Условия и дата",
      "fields": [
        {
          "key": "price",
          "label": "Цена, руб.",
          "type": "number",
          "required": true,
          "placeholder": "0"
        },
        { "key": "price_words", "label": "Цена прописью", "type": "text", "placeholder": "например: один миллион рублей 00 копеек" },
        { "key": "payment", "label": "Порядок и срок оплаты", "type": "textarea", "placeholder": "наличные / перевод, срок и подтверждение расчёта" },
        { "key": "transfer", "label": "Срок, время и место передачи", "type": "text", "placeholder": "дата, время, место" },
        { "key": "condition", "label": "Состояние, недостатки и комплектность", "type": "textarea", "placeholder": "известные недостатки, оборудование, комплект ключей" },
        { "key": "spouse", "label": "Семейное положение / согласие супруга", "type": "textarea", "placeholder": "укажите применимые обстоятельства и реквизиты согласия" },
        { "key": "appendices", "label": "Приложения", "type": "textarea", "placeholder": "акт приёма-передачи, расписка, опись" },
        { "key": "date", "label": "Дата договора", "type": "date" },
        {
          "key": "place",
          "label": "Место заключения",
          "type": "text",
          "placeholder": "г. Москва",
          "placeholder": "город, субъект РФ"
        }
      ]
    }
  ]
}
