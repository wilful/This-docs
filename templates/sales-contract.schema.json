{
  "id": "sales-contract",
  "name": "Договор купли-продажи недвижимости",
  "description": "Квартира, дом или участок: стороны, объект, цена и порядок расчётов.",
  "groups": [
    {
      "id": "buyers",
      "title": "Покупатель",
      "repeatable": true,
      "fields": [
        {
          "key": "fio",
          "label": "ФИО",
          "type": "text",
          "required": true,
          "placeholder": "Иванов Иван Иванович",
          "autocomplete": "name"
        },
        { "key": "phone", "label": "Телефон", "type": "tel", "placeholder": "+7 (___) ___-__-__" },
        {
          "key": "address",
          "label": "Адрес регистрации",
          "type": "text",
          "placeholder": "г. …, ул. …, д. …"
        },
        {
          "key": "passport",
          "label": "Паспорт",
          "type": "text",
          "placeholder": "серия, номер, кем и когда выдан"
        }
      ]
    },
    {
      "id": "sellers",
      "title": "Продавец",
      "repeatable": true,
      "fields": [
        {
          "key": "fio",
          "label": "ФИО",
          "type": "text",
          "required": true,
          "placeholder": "Петров Пётр Петрович",
          "autocomplete": "name"
        },
        { "key": "phone", "label": "Телефон", "type": "tel", "placeholder": "+7 (___) ___-__-__" },
        {
          "key": "address",
          "label": "Адрес регистрации",
          "type": "text",
          "placeholder": "г. …, ул. …, д. …"
        },
        {
          "key": "passport",
          "label": "Паспорт",
          "type": "text",
          "placeholder": "серия, номер, кем и когда выдан"
        },
        {
          "key": "basis",
          "label": "Основание права",
          "type": "text",
          "placeholder": "выписка ЕГРН, договор от …"
        }
      ]
    },
    {
      "id": "object",
      "title": "Объект договора",
      "fields": [
        {
          "key": "object_type",
          "label": "Тип объекта",
          "type": "select",
          "options": ["Квартира", "Жилой дом", "Земельный участок", "Нежилое помещение", "Иное"],
          "placeholder": "Выберите"
        },
        {
          "key": "address",
          "label": "Адрес объекта",
          "type": "text",
          "placeholder": "г. …, ул. …, д. …"
        },
        { "key": "area", "label": "Площадь, кв. м", "type": "number", "placeholder": "0" },
        {
          "key": "cadastral",
          "label": "Кадастровый номер",
          "type": "text",
          "placeholder": "XX:XX:XXXXXXX:XX"
        },
        { "key": "ownership", "label": "Запись о праве в ЕГРН (номер и дата)", "type": "text", "placeholder": "№ … от …" },
        { "key": "encumbrances", "label": "Обременения и ограничения", "type": "textarea", "placeholder": "Отсутствуют или перечислите имеющиеся" },
        { "key": "occupants", "label": "Лица с сохраняемым правом пользования", "type": "textarea", "placeholder": "Отсутствуют или укажите лиц и основание права" }
      ]
    },
    {
      "id": "terms",
      "title": "Условия и дата",
      "fields": [
        {
          "key": "price",
          "label": "Цена, руб.",
          "type": "number",
          "required": true,
          "placeholder": "0"
        },
        { "key": "price_words", "label": "Цена прописью", "type": "text", "placeholder": "например: пять миллионов рублей 00 копеек" },
        {
          "key": "payment",
          "label": "Порядок расчётов",
          "type": "textarea",
          "placeholder": "способ, сроки, аккредитив/эскроу и момент подтверждения оплаты"
        },
        { "key": "transfer", "label": "Срок и условия передачи", "type": "textarea", "placeholder": "срок подписания передаточного акта, ключи, показания счётчиков" },
        { "key": "condition", "label": "Состояние объекта и недостатки", "type": "textarea", "placeholder": "состояние, остающееся имущество, известные недостатки" },
        { "key": "assurances", "label": "Дополнительные заверения продавца", "type": "textarea", "placeholder": "например, сведения о браке, согласии супруга, банкротстве" },
        { "key": "expenses", "label": "Распределение расходов", "type": "text", "placeholder": "кто оплачивает регистрацию и нотариуса" },
        { "key": "appendices", "label": "Приложения", "type": "textarea", "placeholder": "передаточный акт, опись имущества и др." },
        { "key": "date", "label": "Дата договора", "type": "date" },
        {
          "key": "place",
          "label": "Место заключения",
          "type": "text",
          "placeholder": "город, субъект РФ"
        }
      ]
    }
  ]
}
