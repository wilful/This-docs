{
  "id": "car-contract",
  "name": "Договор купли-продажи автомобиля",
  "description": "Официальный образец договора купли-продажи транспортного средства.",
  "groups": [
    {
      "id": "sellers",
      "title": "Продавец",
      "fields": [
        { "key": "fio", "label": "ФИО", "type": "text", "required": true, "placeholder": "Иванов Иван Иванович", "autocomplete": "name" },
        { "key": "birthdate", "label": "Дата рождения", "type": "date" },
        { "key": "passport_series", "label": "Паспорт: серия", "type": "text", "placeholder": "0000" },
        { "key": "passport_number", "label": "Паспорт: номер", "type": "text", "placeholder": "000000" },
        { "key": "passport_issued", "label": "Кем выдан", "type": "text" },
        { "key": "passport_code", "label": "Код подразделения", "type": "text", "placeholder": "000-000" },
        { "key": "passport_date", "label": "Дата выдачи паспорта", "type": "date" },
        { "key": "address", "label": "Адрес регистрации", "type": "text", "placeholder": "город, улица, дом, квартира" },
        { "key": "phone", "label": "Телефон", "type": "tel", "placeholder": "+7 (___) ___-__-__" }
      ]
    },
    {
      "id": "buyers",
      "title": "Покупатель",
      "fields": [
        { "key": "fio", "label": "ФИО", "type": "text", "required": true, "placeholder": "Петров Пётр Петрович", "autocomplete": "name" },
        { "key": "birthdate", "label": "Дата рождения", "type": "date" },
        { "key": "passport_series", "label": "Паспорт: серия", "type": "text", "placeholder": "0000" },
        { "key": "passport_number", "label": "Паспорт: номер", "type": "text", "placeholder": "000000" },
        { "key": "passport_issued", "label": "Кем выдан", "type": "text" },
        { "key": "passport_code", "label": "Код подразделения", "type": "text", "placeholder": "000-000" },
        { "key": "passport_date", "label": "Дата выдачи паспорта", "type": "date" },
        { "key": "address", "label": "Адрес регистрации", "type": "text", "placeholder": "город, улица, дом, квартира" },
        { "key": "phone", "label": "Телефон", "type": "tel", "placeholder": "+7 (___) ___-__-__" }
      ]
    },
    {
      "id": "vehicle",
      "title": "Транспортное средство",
      "fields": [
        { "key": "plate", "label": "Государственный регистрационный знак", "type": "text", "placeholder": "А000АА 77" },
        { "key": "vin", "label": "Идентификационный номер (VIN)", "type": "text", "placeholder": "17 символов" },
        { "key": "model", "label": "Марка, модель", "type": "text", "required": true, "placeholder": "Lada Vesta" },
        { "key": "type", "label": "Наименование (тип ТС)", "type": "text", "placeholder": "легковой автомобиль" },
        { "key": "category", "label": "Категория ТС (ABCD, прицеп)", "type": "text", "placeholder": "B" },
        { "key": "year", "label": "Год выпуска", "type": "number", "placeholder": "2020" },
        { "key": "engine", "label": "Модель, № двигателя", "type": "text", "placeholder": "модель и номер через запятую" },
        { "key": "chassis", "label": "Шасси (рама) №", "type": "text" },
        { "key": "body", "label": "Кузов (кабина, прицеп) №", "type": "text" },
        { "key": "color", "label": "Цвет", "type": "text" },
        { "key": "power", "label": "Мощность двигателя, кВт / л. с.", "type": "text", "placeholder": "кВт / л. с." },
        { "key": "displacement", "label": "Рабочий объём двигателя, куб. см", "type": "number" },
        { "key": "eco_class", "label": "Экологический класс", "type": "text" },
        { "key": "max_mass", "label": "Технически допустимая масса, кг", "type": "number" },
        { "key": "individual_features", "label": "Иные индивидуализирующие признаки (голограммы, рисунки и т.д.)", "type": "textarea" },
        { "key": "pts", "label": "Паспорт транспортного средства (ПТС)", "type": "text" },
        { "key": "pts_issued", "label": "Кем выдан ПТС", "type": "text" },
        { "key": "sts", "label": "СТС: серия", "type": "text" },
        { "key": "sts_issued", "label": "СТС: кем и когда выдано", "type": "text" }
      ]
    },
    {
      "id": "terms",
      "title": "Место, дата и цена договора",
      "fields": [
        { "key": "place", "label": "Город заключения договора", "type": "text", "placeholder": "город" },
        { "key": "date", "label": "Дата заключения договора", "type": "date", "required": true, "defaultToday": true },
        { "key": "price", "label": "Цена транспортного средства, руб.", "type": "number", "required": true, "placeholder": "0" },
        { "key": "price_words", "label": "Цена прописью", "type": "text", "placeholder": "один миллион рублей 00 копеек" }
      ]
    }
  ]
}
