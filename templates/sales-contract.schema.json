{
  "id": "sales-contract",
  "name": "Договор купли-продажи",
  "groups": [
    {
      "id": "buyers",
      "title": "Покупатель",
      "repeatable": true,
      "fields": [
        {
          "key": "fio",
          "label": "ФИО",
          "type": "text",
          "required": true,
          "placeholder": "Иванов Иван Иванович",
          "autocomplete": "name"
        },
        { "key": "phone", "label": "Телефон", "type": "tel", "placeholder": "+7 …" },
        {
          "key": "address",
          "label": "Адрес регистрации",
          "type": "text",
          "placeholder": "г. …, ул. …, д. …"
        },
        {
          "key": "passport",
          "label": "Паспорт",
          "type": "text",
          "placeholder": "серия, номер, кем выдан"
        }
      ]
    },
    {
      "id": "sellers",
      "title": "Продавец",
      "repeatable": true,
      "fields": [
        {
          "key": "fio",
          "label": "ФИО",
          "type": "text",
          "required": true,
          "placeholder": "Петров Пётр Петрович",
          "autocomplete": "name"
        },
        { "key": "phone", "label": "Телефон", "type": "tel", "placeholder": "+7 …" },
        {
          "key": "address",
          "label": "Адрес регистрации",
          "type": "text",
          "placeholder": "г. …, ул. …, д. …"
        },
        {
          "key": "passport",
          "label": "Паспорт",
          "type": "text",
          "placeholder": "серия, номер, кем выдан"
        }
      ]
    },
    {
      "id": "object",
      "title": "Объект договора",
      "fields": [
        {
          "key": "object_type",
          "label": "Тип объекта",
          "type": "select",
          "options": ["Квартира", "Дом", "Земельный участок", "Иное"],
          "placeholder": "Выберите"
        },
        {
          "key": "address",
          "label": "Адрес объекта",
          "type": "text",
          "placeholder": "г. …, ул. …, д. …"
        },
        { "key": "area", "label": "Площадь, кв.м", "type": "number", "placeholder": "0" },
        {
          "key": "cadastral",
          "label": "Кадастровый номер",
          "type": "text",
          "placeholder": "…-…-…"
        }
      ]
    },
    {
      "id": "terms",
      "title": "Условия и дата",
      "fields": [
        {
          "key": "price",
          "label": "Цена, руб.",
          "type": "number",
          "required": true,
          "placeholder": "0"
        },
        { "key": "date", "label": "Дата договора", "type": "date" },
        {
          "key": "place",
          "label": "Место заключения",
          "type": "text",
          "placeholder": "г. Москва"
        }
      ]
    }
  ]
}
